# Copy this file to .env and fill in real values.
# .env is gitignored and should never be committed.

PORT=3000

# Seed admin account created by `npm run init-db`
ADMIN_EMAIL=admin@example.com
# Wrap in quotes if the password contains '#', otherwise it is cut off there
ADMIN_PASSWORD="change-me-to-a-strong-password"
ADMIN_PHONE=0000000000

# Optional: custom SQLite file location (defaults to backend/database/society-booking.db)
# DB_PATH=
